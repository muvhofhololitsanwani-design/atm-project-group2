digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.8, fontname="Carlito", splines=true, pad=0.2, bgcolor="white",
         label=""];
  node [fontname="Carlito"];
  edge [fontname="Carlito", fontsize=10];
  ATM [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#D6E4F7" ALIGN="CENTER" CELLPADDING="4"><B>ATM</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-accounts : List&lt;Account&gt;<BR ALIGN="LEFT"/>-currentAccount : Account<BR ALIGN="LEFT"/>-failedAttempts : int<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+ATM()<BR ALIGN="LEFT"/>+authenticate(String accNo, String pin) : boolean<BR ALIGN="LEFT"/>+withdraw(double)<BR ALIGN="LEFT"/>+deposit(double)<BR ALIGN="LEFT"/>+getBalance() : double<BR ALIGN="LEFT"/>+logout()<BR ALIGN="LEFT"/>+isLoggedIn() : boolean<BR ALIGN="LEFT"/>+isLocked() : boolean<BR ALIGN="LEFT"/>+getFailedAttempts() : int<BR ALIGN="LEFT"/>+getRemainingAttempts() : int<BR ALIGN="LEFT"/>+getCurrentAccountNumber() : String<BR ALIGN="LEFT"/>+getRemainingDailyLimit() : double<BR ALIGN="LEFT"/>+getRecentTransactions(int) : List&lt;Transaction&gt;<BR ALIGN="LEFT"/>-findAccount(String) : Account<BR ALIGN="LEFT"/>-requireLogin() : Account<BR ALIGN="LEFT"/>-isWholeNotes(double) : boolean<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Account [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#FBE8C4" ALIGN="CENTER" CELLPADDING="4"><B>Account</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-accountNumber : String<BR ALIGN="LEFT"/>-pinSalt : byte[]<BR ALIGN="LEFT"/>-pinHash : byte[]<BR ALIGN="LEFT"/>-balance : double<BR ALIGN="LEFT"/>-history : List&lt;Transaction&gt;<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+Account(String, String pin, double balance)<BR ALIGN="LEFT"/>+validatePin(String) : boolean<BR ALIGN="LEFT"/>+deposit(double)<BR ALIGN="LEFT"/>+withdraw(double)<BR ALIGN="LEFT"/>+getBalance() : double<BR ALIGN="LEFT"/>+getAccountNumber() : String<BR ALIGN="LEFT"/>+getHistory() : List&lt;Transaction&gt;<BR ALIGN="LEFT"/>+getWithdrawnOn(LocalDate) : double<BR ALIGN="LEFT"/>-hashPin(String, byte[]) : byte[]<BR ALIGN="LEFT"/>-roundToCents(double) : double<BR ALIGN="LEFT"/>-requirePositive(double) : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Transaction [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#FBE8C4" ALIGN="CENTER" CELLPADDING="4"><B>Transaction</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-type : Type<BR ALIGN="LEFT"/>-amount : double<BR ALIGN="LEFT"/>-balanceAfter : double<BR ALIGN="LEFT"/>-timestamp : LocalDateTime<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+Transaction(Type, double, double)<BR ALIGN="LEFT"/>+Transaction(Type, double, double, LocalDateTime)<BR ALIGN="LEFT"/>+getType() : Type<BR ALIGN="LEFT"/>+getAmount() : double<BR ALIGN="LEFT"/>+getBalanceAfter() : double<BR ALIGN="LEFT"/>+getTimestamp() : LocalDateTime<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Type [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#FBE8C4" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="10">&#171;enumeration&#187;</FONT><BR/><B>Type</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">DEPOSIT<BR ALIGN="LEFT"/>WITHDRAWAL<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+getLabel() : String<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  InputValidator [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#D6E4F7" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="10">&#171;utility&#187;</FONT><BR/><B>InputValidator</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-AMOUNT_PATTERN : Pattern<BR ALIGN="LEFT"/>-PIN_PATTERN : Pattern<BR ALIGN="LEFT"/>-ACCOUNT_PATTERN : Pattern<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-InputValidator()<BR ALIGN="LEFT"/>+parseAmount(String) : double<BR ALIGN="LEFT"/>+isValidPin(String) : boolean<BR ALIGN="LEFT"/>+isValidAccountNumber(String) : boolean<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  InvalidAmountException [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#F8D3D3" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="10">&#171;checked&#187;</FONT><BR/><B>InvalidAmountException</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="3"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+InvalidAmountException(String)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  InsufficientFundsException [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#F8D3D3" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="10">&#171;checked&#187;</FONT><BR/><B>InsufficientFundsException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-available : double<BR ALIGN="LEFT"/>-requested : double<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+InsufficientFundsException(double, double)<BR ALIGN="LEFT"/>+getAvailable() : double<BR ALIGN="LEFT"/>+getRequested() : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  Exception [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#E6E6E6" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="10">&#171;java.lang&#187;</FONT><BR/><B>Exception</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="3"> </FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="3"> </FONT></TD></TR></TABLE>>];
  AppConstants [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#FBE8C4" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="10">&#171;constants&#187;</FONT><BR/><B>AppConstants</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+INITIAL_BALANCE = 10000.00<BR ALIGN="LEFT"/>+MAX_PIN_ATTEMPTS = 3<BR ALIGN="LEFT"/>+PIN_LENGTH = 4<BR ALIGN="LEFT"/>+NOTE_DENOMINATION = 10.00<BR ALIGN="LEFT"/>+DAILY_WITHDRAWAL_LIMIT = 5000.00<BR ALIGN="LEFT"/>+MINI_STATEMENT_SIZE = 5<BR ALIGN="LEFT"/>+SESSION_TIMEOUT_SECONDS = 120<BR ALIGN="LEFT"/>+DEMO_ACCOUNT_NUMBER, DEMO_PIN : String<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-AppConstants()<BR ALIGN="LEFT"/>+getQuickAmounts() : double[]<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];

  { rank=same; Account; InputValidator; }
  { rank=same; Transaction; InsufficientFundsException; InvalidAmountException; }
  { rank=same; Type; Exception; AppConstants; }

  edge [arrowhead=empty, style=solid, color="#33415C"];
  InvalidAmountException -> Exception; InsufficientFundsException -> Exception;
  edge [arrowhead=none, arrowtail=odiamond, dir=back, style=solid, color="#33415C", fontsize=11];
  ATM -> Account [taillabel="1", headlabel="1..*", label="  holds"];
  edge [arrowhead=none, arrowtail=diamond, dir=back];
  Account -> Transaction [taillabel="1", headlabel="0..*", label="  records"];
  edge [arrowhead=vee, arrowtail=none, dir=forward, style=solid];
  Transaction -> Type [label="  type"];
  edge [arrowhead=vee, style=dashed, color="#B03A3A", fontsize=10, dir=forward, arrowtail=none];
  Account -> InsufficientFundsException [label=" throws"];
  ATM -> InsufficientFundsException [label=" throws"];
  ATM -> InvalidAmountException [label=" throws"];
  InputValidator -> InvalidAmountException [label=" throws"];

}

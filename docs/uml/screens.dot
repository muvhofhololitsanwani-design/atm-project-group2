digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.8, fontname="Carlito", splines=true, pad=0.2, bgcolor="white",
         label=""];
  node [fontname="Carlito"];
  edge [fontname="Carlito", fontsize=10];
  ATMApp [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#CDEFE6" ALIGN="CENTER" CELLPADDING="4"><B>ATMApp</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="3"> </FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+main(String[] args)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  SessionMonitor [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#CDEFE6" ALIGN="CENTER" CELLPADDING="4"><B>SessionMonitor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-atm : ATM<BR ALIGN="LEFT"/>-timeoutSeconds : int<BR ALIGN="LEFT"/>-idleTimer : Timer<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+SessionMonitor(ATM, int)<BR ALIGN="LEFT"/>+start()<BR ALIGN="LEFT"/>-handleTimeout()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  JFrame [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#E6E6E6" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="10">&#171;javax.swing&#187;</FONT><BR/><B>JFrame</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="3"> </FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="3"> </FONT></TD></TR></TABLE>>];
  LoginFrame [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#CDEFE6" ALIGN="CENTER" CELLPADDING="4"><B>LoginFrame</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-atm : ATM<BR ALIGN="LEFT"/>-txtAccNo : JTextField<BR ALIGN="LEFT"/>-pfPin : JPasswordField<BR ALIGN="LEFT"/>-chkShowPin : JCheckBox<BR ALIGN="LEFT"/>-btnLogin : JButton<BR ALIGN="LEFT"/>-lblMessage : JLabel<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+LoginFrame(ATM)<BR ALIGN="LEFT"/>-handleLogin()<BR ALIGN="LEFT"/>-shakeWindow()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  MainMenuFrame [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#CDEFE6" ALIGN="CENTER" CELLPADDING="4"><B>MainMenuFrame</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-atm : ATM<BR ALIGN="LEFT"/>-btnWithdraw : JButton<BR ALIGN="LEFT"/>-btnDeposit : JButton<BR ALIGN="LEFT"/>-btnBalance : JButton<BR ALIGN="LEFT"/>-btnExit : JButton<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+MainMenuFrame(ATM)<BR ALIGN="LEFT"/>-handleChoice(String)<BR ALIGN="LEFT"/>-confirmExit()<BR ALIGN="LEFT"/>-greeting() : String<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  WithdrawFrame [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#CDEFE6" ALIGN="CENTER" CELLPADDING="4"><B>WithdrawFrame</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-atm : ATM<BR ALIGN="LEFT"/>-txtAmount : JTextField<BR ALIGN="LEFT"/>-btnConfirm : JButton<BR ALIGN="LEFT"/>-btnBack : JButton<BR ALIGN="LEFT"/>-lblLimit : JLabel<BR ALIGN="LEFT"/>-lblMessage : JLabel<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+WithdrawFrame(ATM)<BR ALIGN="LEFT"/>-handleConfirm()<BR ALIGN="LEFT"/>-refreshLimit()<BR ALIGN="LEFT"/>-goBack()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  DepositFrame [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#CDEFE6" ALIGN="CENTER" CELLPADDING="4"><B>DepositFrame</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-atm : ATM<BR ALIGN="LEFT"/>-txtAmount : JTextField<BR ALIGN="LEFT"/>-btnConfirm : JButton<BR ALIGN="LEFT"/>-btnBack : JButton<BR ALIGN="LEFT"/>-lblBalance : JLabel<BR ALIGN="LEFT"/>-lblMessage : JLabel<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+DepositFrame(ATM)<BR ALIGN="LEFT"/>-handleConfirm()<BR ALIGN="LEFT"/>-refreshBalance()<BR ALIGN="LEFT"/>-goBack()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  BalanceFrame [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#CDEFE6" ALIGN="CENTER" CELLPADDING="4"><B>BalanceFrame</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-atm : ATM<BR ALIGN="LEFT"/>-lblBalance : JLabel<BR ALIGN="LEFT"/>-btnBack : JButton<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+BalanceFrame(ATM)<BR ALIGN="LEFT"/>-buildStatement() : JPanel<BR ALIGN="LEFT"/>-goBack()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  UIStyle [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#E8E0F3" ALIGN="CENTER" CELLPADDING="4"><FONT POINT-SIZE="10">&#171;utility&#187;</FONT><BR/><B>UIStyle</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">+WINDOW_WIDTH, WINDOW_HEIGHT : int<BR ALIGN="LEFT"/>+BG_TOP, ACCENT, TEXT, ERROR, SUCCESS ... : Color<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="11">-UIStyle()<BR ALIGN="LEFT"/>+styleFrame(JFrame, String)<BR ALIGN="LEFT"/>+createButton(String) : JButton<BR ALIGN="LEFT"/>+createSecondaryButton(String) : JButton<BR ALIGN="LEFT"/>+createDangerButton(String) : JButton<BR ALIGN="LEFT"/>+createQuickAmountPanel(JTextField, double...) : JPanel<BR ALIGN="LEFT"/>+createTextField() : JTextField<BR ALIGN="LEFT"/>+createPasswordField() : JPasswordField<BR ALIGN="LEFT"/>+createCheckBox(String) : JCheckBox<BR ALIGN="LEFT"/>+createTitleLabel / createLabel / createHintLabel(String) : JLabel<BR ALIGN="LEFT"/>+createMessageLabel() : JLabel<BR ALIGN="LEFT"/>+showError / showSuccess(JLabel, String)<BR ALIGN="LEFT"/>+clearMessage(JLabel)<BR ALIGN="LEFT"/>+createPanel / createScreenPanel / createCardPanel / createColumn() : JPanel<BR ALIGN="LEFT"/>+createHeader(String, String) : JPanel<BR ALIGN="LEFT"/>+formatMoney(double) : String<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  ATM [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#33415C"><TR><TD BGCOLOR="#D6E4F7" CELLPADDING="5"><FONT POINT-SIZE="10">&#171;see Figure 2&#187;</FONT><BR/><B>ATM</B></TD></TR></TABLE>>];
  { rank=same; ATMApp; SessionMonitor; JFrame; }
  { rank=same; LoginFrame; MainMenuFrame; WithdrawFrame; DepositFrame; BalanceFrame; }
  { rank=same; ATM; UIStyle; }

  edge [arrowhead=empty, style=solid, color="#33415C"];
  LoginFrame -> JFrame; MainMenuFrame -> JFrame; WithdrawFrame -> JFrame;
  DepositFrame -> JFrame; BalanceFrame -> JFrame;
  edge [arrowhead=vee, style=dashed, color="#33415C", fontsize=10];
  ATMApp -> LoginFrame [label=" opens"];
  ATMApp -> SessionMonitor [label=" starts"];
  SessionMonitor -> LoginFrame [label=" reopens", constraint=false];
  LoginFrame -> MainMenuFrame [label=" opens", constraint=false];
  MainMenuFrame -> WithdrawFrame [label=" opens", constraint=false];
  MainMenuFrame -> DepositFrame [constraint=false];
  MainMenuFrame -> BalanceFrame [constraint=false];
  edge [arrowhead=vee, style=solid, color="#1B7F6B", fontsize=10];
  LoginFrame -> ATM; MainMenuFrame -> ATM; WithdrawFrame -> ATM;
  DepositFrame -> ATM; BalanceFrame -> ATM;
  SessionMonitor -> ATM [constraint=false];

}
